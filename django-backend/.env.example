# Django auth and email settings
# Copy this file to .env and fill values for your email provider.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@vloghub.com

# Reset code validity in minutes
PASSWORD_RESET_CODE_TTL_MINUTES=15

# Cooldown between forgot-password requests per account (seconds)
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
